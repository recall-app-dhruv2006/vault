# ---- Public (safe to expose to the browser; must be prefixed NEXT_PUBLIC_) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Server-only secrets (NEVER exposed to the browser, NEVER prefix with NEXT_PUBLIC_) ----
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Embedding provider key. Defaults to Anthropic-compatible Voyage AI (recommended pairing for Claude).
EMBEDDING_API_KEY=
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3-lite

# Optional: Google OAuth (configure in Supabase Auth providers, no extra app env vars required)
# Optional: Stripe (billing scaffolding only, not wired up in MVP)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Rate limiting / misc
RATE_LIMIT_ENABLED=true
